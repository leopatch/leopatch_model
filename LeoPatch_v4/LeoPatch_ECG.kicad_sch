	(text "Lead cable: 3.5 mm TRS plug, Tip = RL, Ring = LA, Sleeve = RA. J202 = backup solder pads."
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0844bae8-2a95-43dd-8516-f6b1ee9cc2f9")
	)
	(text "Input network as on the MAX30003WING2 evaluation kit: 49.9k pulse-proof series resistors, C201 1 nF across ECGP-ECGN,\nC213 / C214 10 pF to GND (matched C0G), R208 499k from VCM to the RL electrode. C202 1 uF = 0.5 Hz high-pass."
		(exclude_from_sim no)
		(at 25.146 48.768 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "38bfab83-1a21-4b02-a01a-92e164ad9c6d")
	)
	(text "Status LED D201 LEADS: firmware lights it while both electrodes are on (DCLOFFINT clear)."
		(exclude_from_sim no)
		(at 278.13 58.674 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "436dbbc6-35f0-4b25-8e98-c4d3c549588d")
	)
	(text "ECG FRONT END: MAX30003, two-electrode (Figure 11 of the datasheet).\nECGP = LA, ECGN = RA (lead I). The third electrode (RL) is not used by the chip; its jack and header pins are only tied together."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5b26ae8e-2e4a-48a4-a88f-3ac37cd0000c")
	)
	(text "Test points (bare 1.5 mm pads, top side, not in the BOM)"
		(exclude_from_sim no)
		(at 38.1 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6f7eb0a6-6bc7-42da-8b1a-a9124740f7d5")
	)
	(text "Module pins: SCK P1.16 (E9), MOSI P1.06 (K8), MISO P1.02 (A8), CS P0.05 (D9), INT P3.07 (C9)."
		(exclude_from_sim no)
		(at 138.684 156.972 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a3b07d40-f0fe-4bf1-80e0-4da1aedf5081")
	)
	(text "C202 sets the analog high-pass: 10 uF = 0.04 Hz (waveform quality), 1 uF = 0.4 Hz (more motion rejection).\nGain (20/40/80/160), 0.5 Hz digital high-pass and 40/100/150 Hz low-pass are set over SPI."
		(exclude_from_sim no)
		(at 138.684 141.732 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b3316894-196b-4cb2-8390-ffcb33995777")
	)
	(text "AVDD/DVDD 1.8 V from U202; OVDD = 3.3 V so the SPI lines match the module. FCLK must be 32.768 kHz (X201)."
		(exclude_from_sim no)
		(at 138.684 149.352 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e040feb8-9ca5-4517-a52e-d2fe95453cf6")
	)
