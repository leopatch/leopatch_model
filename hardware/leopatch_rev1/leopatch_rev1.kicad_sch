	(text "LeoPatch Rev 1: the nRF54LM20 DK (PCA10184 v0.7.0) with the debugger and development parts removed, plus an AD8232 ECG front end, a LiPo battery and a 2.7 V supply."
		(exclude_from_sim no)
		(at 30.48 165.1 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a851d247-a2c4-5d67-ab28-474913d9ec7b")
	)
	(text "Parts kept from the DK use the DK's designators and the DK's own pin-to-net connections, so 'Update PCB from Schematic' can re-link them to the DK layout by reference."
		(exclude_from_sim no)
		(at 30.48 172.72 0)
		(effects
